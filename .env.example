# Supabase BARU. Variabel ini hanya digunakan server.
HUB_SUPABASE_URL=
HUB_SUPABASE_SERVICE_KEY=
# Token acak minimal 32 karakter untuk pengaturan PIN pertama.
HUB_SETUP_TOKEN=
# Lokal: sesuai hostname npm run dev. Vercel: domain HTTPS aplikasi tanpa path /pin.
# Domain deployment Vercel juga dikenali dari metadata server platform.
HUB_APP_ORIGIN=http://127.0.0.1:3000
# Mode demo lokal (opsional): 1 = data contoh di memori tanpa Supabase dan tanpa PIN.
# Tidak pernah aktif di Vercel. Lebih mudah: npm run dev:demo
NEXT_PUBLIC_MODE_DEMO=
